  "config_subentries": {
    "sp_account": {
      "initiate_flow": {
        "user": "Add SP account"
      },
      "entry_type": "SP account",
      "step": {
        "user": {
          "title": "Add SP Group e-account",
          "description": "Sign in with the same e-account email and password used in the SP app. The password is not stored: only the session tokens SP returns are kept. Electricity cost for the Energy dashboard uses this integration's SP Group tariff automatically.",
          "data": {
            "username": "Email",
            "password": "Password"
          }
        },
        "mfa": {
          "title": "SP Group verification",
          "description": "Enter the one-time verification code.",
          "data": {
            "mfa_code": "Verification code"
          }
        },
        "reconfigure": {
          "title": "Sign in to SP Group again",
          "description": "Use this when the session expired or the password changed.",
          "data": {
            "username": "Email",
            "password": "Password"
          }
        }
      },
      "error": {
        "invalid_auth": "Invalid e-account email or password.",
        "cannot_connect": "Could not reach SP Group.",
        "requires_verification": "SP flagged this login as suspicious. Sign in once in the SP app, wait a few minutes, then try again.",
        "too_many_attempts": "Too many sign-in attempts. Wait a minute before trying again.",
        "invalid_username": "Enter a valid e-account email (at most 254 bytes).",
        "invalid_password": "Enter your password (at most 1024 characters)."
      },
      "abort": {
        "already_configured": "This SP e-account is already added.",
        "reconfigure_successful": "Signed in again.",
        "unique_id_mismatch": "The email does not match this SP e-account. Add it as a new account instead."
      }
    }
  },
  "exceptions": {
    "auth_failed": {
      "message": "SP Group rejected the stored e-account credentials: {error}"
    },
    "requires_verification": {
      "message": "SP flagged this login as suspicious. Sign in once in the SP app, wait a few minutes, then retry: {error}"
    },
    "usage_failed": {
      "message": "Could not fetch usage from SP Group: {error}"
    },
    "http_error": {
      "message": "{source} returned HTTP {status}"
    },
    "fetch_failed": {
      "message": "Could not fetch {source}: {error}"
    },
    "bad_payload": {
      "message": "{source} sent data in an unexpected format: {detail}"
    }
  },
  "issues": {
    "sp_account_auth_failed": {
      "title": "SP account {title} needs you to sign in again",
      "description": "SP Group rejected the stored session for {title}. Go to Settings → Devices & services → Singapore, open the {title} SP account entry, choose Reconfigure and sign in again. Its sensors stay unavailable until then; the rest of the integration keeps working."
    },
    "source_failing": {
      "title": "{source} has been failing for a day",
      "description": "Singapore could not update {source} for the past 24 hours. The source may have changed its website or API. Last error: `{error}`\n\nCheck [the issue tracker]({issue_tracker}) and report it (attach the integration's diagnostics). If you don't need this data, turn the source off under Settings → Devices & services → Singapore → Configure. This notice clears itself once an update succeeds."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Singapore options",
        "description": "Choose which data sources run. A source you turn off stops polling, and its entities and devices are removed (turn it back on to get them back). Saving reloads the integration.",
        "data": {
          "sources": "Data sources",
          "school_events": "School calendars",
          "api_key": "data.gov.sg API key",
          "carparks": "HDB carparks",
          "polling": "Polling"
        },
        "data_description": {
          "sources": "Turning off SP Group tariffs also leaves SP account cost statistics unpriced. HDB carpark availability, taxi availability and CapitaLand mall carparks are off until you tick them: the first two download island-wide data on each poll; CapitaLand's lots come from its JustPark website.",
          "school_events": "Which MOE school calendars to create when the MOE school calendar source is on.",
          "api_key": "Optional. A free key from data.gov.sg gives higher rate limits (fewer HTTP 429 errors). Leave empty to use the public limits.",
          "carparks": "Carpark numbers to track when HDB carpark availability is on, separated by commas (e.g. BJ55, TM24; shown on HDB's and data.gov.sg's carpark lists). Leave empty for the 3 carparks nearest your home location.",
          "polling": "Reduced polls the fast sources (flood alerts, lightning, traffic cameras, radar, trains, weather, PSI, UV, heat stress, carparks, taxis, CapitaLand carparks) three times less often."
        }
      }
    },
    "error": {
      "no_sources": "Turn on at least one data source, or add an SP account first.",
      "no_school_events": "Choose at least one school calendar, or turn off the MOE school calendar source."
    }
  },
