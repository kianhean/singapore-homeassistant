  "issues": {
    "sp_account_auth_failed": {
      "title": "Akaun SP {title} memerlukan anda log masuk semula",
      "description": "SP Group menolak sesi yang disimpan untuk {title}. Pergi ke Tetapan → Peranti & perkhidmatan → Singapura, buka entri akaun SP {title}, pilih Konfigurasi semula dan log masuk semula. Sensornya kekal tidak tersedia sehingga itu; bahagian lain integrasi terus berfungsi."
    },
    "source_failing": {
      "title": "{source} gagal selama sehari",
      "description": "Singapura tidak dapat mengemas kini {source} selama 24 jam yang lalu. Sumber mungkin telah menukar laman web atau API-nya. Ralat terakhir: `{error}`\n\nSemak [penjejak isu]({issue_tracker}) dan laporkannya (lampirkan diagnostik integrasi). Jika anda tidak memerlukan data ini, matikan sumber di bawah Tetapan → Peranti & perkhidmatan → Singapura → Konfigurasi. Notis ini akan hilang sendiri setelah kemas kini berjaya."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Pilihan Singapura",
        "description": "Pilih sumber data yang dijalankan. Sumber yang dimatikan berhenti mengundi, dan entiti serta perantinya dibuang (hidupkan semula untuk mendapatkannya kembali). Menyimpan akan memuat semula integrasi.",
        "data": {
          "sources": "Sumber data",
          "school_events": "Kalendar sekolah",
          "api_key": "Kunci API data.gov.sg",
          "carparks": "Tempat letak kereta HDB",
          "polling": "Pengundian"
        },
        "data_description": {
          "sources": "Mematikan tarif SP Group juga menyebabkan statistik kos akaun SP tidak berharga. Ketersediaan tempat letak kereta HDB, ketersediaan teksi dan tempat letak kereta pusat beli-belah CapitaLand dimatikan sehingga anda menandakannya: dua yang pertama memuat turun data seluruh pulau pada setiap pengundian; lot CapitaLand datang dari laman web JustPark.",
          "school_events": "Kalendar sekolah MOE yang hendak dicipta apabila sumber kalendar sekolah MOE dihidupkan.",
          "api_key": "Pilihan. Kunci percuma daripada data.gov.sg memberikan had kadar yang lebih tinggi (kurang ralat HTTP 429). Biarkan kosong untuk menggunakan had awam.",
          "carparks": "Nombor tempat letak kereta untuk dijejaki apabila ketersediaan tempat letak kereta HDB dihidupkan, dipisahkan dengan koma (cth. BJ55, TM24; ditunjukkan pada senarai tempat letak kereta HDB dan data.gov.sg). Biarkan kosong untuk 3 tempat letak kereta terdekat dengan lokasi rumah anda.",
          "polling": "Dikurangkan mengundi sumber pantas (amaran banjir, kilat, kamera trafik, radar, kereta api, cuaca, PSI, UV, tekanan haba, tempat letak kereta, teksi, tempat letak kereta CapitaLand) tiga kali kurang kerap."
        }
      }
    },
    "error": {
      "no_sources": "Hidupkan sekurang-kurangnya satu sumber data, atau tambah akaun SP terlebih dahulu.",
