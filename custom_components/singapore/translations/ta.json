      "entry_type": "SP கணக்கு",
      "step": {
        "user": {
          "title": "SP Group மின்-கணக்கைச் சேர்",
          "description": "SP செயலியில் பயன்படுத்தும் அதே மின்-கணக்கு மின்னஞ்சல் மற்றும் கடவுச்சொல்லுடன் உள்நுழையவும். கடவுச்சொல் சேமிக்கப்படாது: SP வழங்கும் அமர்வு டோக்கன்கள் மட்டுமே சேமிக்கப்படும். ஆற்றல் பலகைக்கான மின்சார செலவு இந்த ஒருங்கிணைப்பின் SP Group கட்டணத்தைத் தானாகவே பயன்படுத்தும்.",
          "data": {
            "username": "மின்னஞ்சல்",
            "password": "கடவுச்சொல்"
          }
        },
        "mfa": {
          "title": "SP Group சரிபார்ப்பு",
          "description": "ஒருமுறை சரிபார்ப்புக் குறியீட்டை உள்ளிடவும்.",
          "data": {
            "mfa_code": "சரிபார்ப்புக் குறியீடு"
          }
        },
        "reconfigure": {
          "title": "SP Group இல் மீண்டும் உள்நுழையவும்",
          "description": "அமர்வு காலாவதியானால் அல்லது கடவுச்சொல் மாறியிருந்தால் இதைப் பயன்படுத்தவும்.",
          "data": {
            "username": "மின்னஞ்சல்",
            "password": "கடவுச்சொல்"
          }
        }
