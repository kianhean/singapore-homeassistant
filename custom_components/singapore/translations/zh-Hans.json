  "config_subentries": {
    "sp_account": {
      "initiate_flow": {
        "user": "添加 SP 账户"
      },
      "entry_type": "SP 账户",
      "step": {
        "user": {
          "title": "添加 SP Group 电子账户",
          "description": "使用您在 SP 应用中登录的电子账户邮箱和密码登录。密码不会被保存：只保留 SP 返回的会话令牌。能源仪表板中的电费会自动使用本集成获取的 SP Group 电价。",
          "data": {
            "username": "邮箱",
            "password": "密码"
          }
        },
        "mfa": {
          "title": "SP Group 验证",
          "description": "请输入一次性验证码。",
          "data": {
            "mfa_code": "验证码"
          }
        },
        "reconfigure": {
          "title": "重新登录 SP Group",
          "description": "会话过期或密码更改后使用此项。",
          "data": {
            "username": "邮箱",
            "password": "密码"
          }
        }
      },
      "error": {
        "invalid_auth": "电子账户邮箱或密码无效。",
        "cannot_connect": "无法连接 SP Group。",
        "requires_verification": "SP 将此次登录标记为可疑。请先在 SP 应用中登录一次，等待几分钟后再试。",
        "too_many_attempts": "登录尝试次数过多。请等待一分钟后再试。",
        "invalid_username": "请输入有效的电子账户邮箱（不超过 254 字节）。",
        "invalid_password": "请输入密码（不超过 1024 个字符）。"
      },
      "abort": {
        "already_configured": "此 SP 电子账户已添加。",
        "reconfigure_successful": "已重新登录。",
        "unique_id_mismatch": "该邮箱与此 SP 电子账户不符。请改为添加新账户。"
      }
    }
  },
  "exceptions": {
    "auth_failed": {
      "message": "SP Group 拒绝了已保存的电子账户凭据：{error}"
    },
    "requires_verification": {
      "message": "SP 将此次登录标记为可疑。请先在 SP 应用中登录一次，等待几分钟后重试：{error}"
    },
    "usage_failed": {
      "message": "无法从 SP Group 获取用量：{error}"
    },
    "http_error": {
      "message": "{source} 返回了 HTTP {status}"
    },
    "fetch_failed": {
      "message": "无法获取 {source}：{error}"
    },
    "bad_payload": {
      "message": "{source} 返回的数据格式不符合预期：{detail}"
    }
  },
  "issues": {
    "sp_account_auth_failed": {
      "title": "SP 账户 {title} 需要重新登录",
      "description": "SP Group 拒绝了 {title} 的已保存会话。请前往 设置 → 设备与服务 → 新加坡，打开 {title} SP 账户条目，选择“重新配置”并重新登录。在此之前其传感器将不可用；集成的其他部分照常运行。"
    },
    "source_failing": {
      "title": "{source} 已连续一天更新失败",
      "description": "过去 24 小时内新加坡集成无法更新 {source}。该数据源的网站或 API 可能已更改。最近的错误：`{error}`\n\n请查看[问题跟踪器]({issue_tracker})并报告此问题（附上集成的诊断信息）。如果您不需要这些数据，可在 设置 → 设备与服务 → 新加坡 → 配置 中关闭该数据源。更新成功后此通知会自动消失。"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "新加坡选项",
        "description": "选择要运行的数据源。关闭的数据源会停止轮询，其实体和设备会被移除（重新开启即可恢复）。保存后集成会重新加载。",
        "data": {
          "sources": "数据源",
          "api_key": "data.gov.sg API 密钥",
          "polling": "轮询频率"
        },
        "data_description": {
          "sources": "关闭 SP Group 电价后，SP 账户的费用统计也将不再计价。",
          "api_key": "可选。data.gov.sg 的免费密钥可提供更高的速率限制（减少 HTTP 429 错误）。留空则使用公共限制。",
          "polling": "“降低”会将快速数据源（淹水警报、雷击、交通摄像头、雷达、列车、天气、PSI、紫外线）的轮询频率降低为三分之一。"
        }
      }
    },
    "error": {
      "no_sources": "请至少开启一个数据源，或先添加一个 SP 账户。"
    }
  },
