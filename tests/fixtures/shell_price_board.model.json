{"organism": "Page", "children": [{"organism": "Container.Raw", "children": [{"organism": "Metadata", "model": {"title": "Shell Station Price Board", "text": "<p>Check the latest fuel prices at our stations</p>\r\n", "links": [{"name": "Shell Station Price Board", "value": "https://www.shell.com.sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board.html"}], "image": {"src": "https://www.shell.com.sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/_jcr_content/root/metadata.shellimg.png/1738583514237/netherlands-assets-shell-pecten-with-sky-cda-169.png", "alt": "Shell Pecten on the background of the blue sky", "width": 2277, "height": 1286}}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/metadata"}, {"organism": "Container.Header", "children": [{"organism": "Container.Raw", "ref": "https://www.shell.com.sg/_jcr_content/root/header/inherited.model.json", "model": {}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/header/inherited"}, {"organism": "Breadcrumb", "model": {"links": [{"name": "Home", "value": "https://www.shell.com.sg/"}, {"name": "Shell engine oils and lubricants", "value": "https://www.shell.com.sg/fuels-oils-and-coolants.html"}, {"name": "Shell Fuels", "value": "https://www.shell.com.sg/fuels-oils-and-coolants/shell-fuels.html"}, {"name": "Shell Station Price Board", "value": "https://www.shell.com.sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board.html"}]}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/header/breadcrumb"}], "model": {}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/header"}, {"organism": "Container.Main", "children": [{"organism": "Container.Section", "children": [{"organism": "PageHeader", "color": "inherited", "model": {"title": "Shell Station Price Board", "text": "<p>Check the latest fuel prices at our stations</p>\r\n\r\n\r\n", "image": {"src": "https://www.shell.com.sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/_jcr_content/root/main/section/page_header.shellimg.png/1738583824900/netherlands-assets-shell-pecten-with-sky-cda-169.png", "alt": "Shell Pecten on the background of the blue sky", "width": 2275, "height": 569}}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section/page_header"}, {"organism": "PromoSimple.Text", "color": "inherited", "model": {"text": "<p>The information provided here has been updated as of <b>18<sup>th</sup>&nbsp;November 2026 17:00 Hrs.</b>&nbsp;For the most up-to-date information, please contact our Shell Service Centre at +65 6235 3261 or email&nbsp;<a href=\"mailto:generalpublicenquiries-sg@shell.com\">generalpublicenquiries-sg@shell.com</a>.</p>\r\n<p>Please use our Shell Station Locator to find the Shell station nearest to you.</p>\r\n"}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section/text"}, {"organism": "WebComponent", "color": "brand1", "model": {"links": [{"value": "https://www.shell.com.sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/_jcr_content/root/main/section/web_component.stream/1795066863921/1f6a2e39676483722c20f1b9a2496b8d760fd791/standalone-table.js"}, {"name": "src", "value": "https://www.shell.com.sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/_jcr_content/root/main/section/web_component/links/item0.stream/1794990192217/e154dfd321d3df5f50e9d304bacb22190380a44f/fuel-price-update-singapore.xlsx"}]}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section/web_component"}, {"organism": "PromoSimple.Text", "color": "inherited", "model": {"text": "<p>Plus! SAFRA and&nbsp;Hometeam&nbsp;NS members (exclude Private Hire scheme members) enjoy&nbsp;ADDITIONAL +2%&nbsp;instant fuel discount, enjoying up to&nbsp;19%&nbsp;savings!</p>\r\n<p>Find out more: <a href=\"https://www.shell.com.sg/rewards-and-savings/shell-go-plus-safra-membership-program.html\">http://shell.com.sg/SAFRAMembers</a> and <a href=\"https://www.shell.com.sg/rewards-and-savings/home-team-ns.html\">http://shell.com.sg/HometeamNS\u200b</a></p>\r\n<p><sup>1</sup>&nbsp;<sub>Enjoy additional savings with Shell GO+, earn 1-1.2 GO+ points with every 1L spent at Shell. Redeem $2 off with every 60 GO+ points. Find out more at&nbsp;<a href=\"https://www.shell.com.sg/rewards-and-savings/shell-app.html\">shell.com.sg/shellgoplus</a></sub></p>\r\n<p><sup>2</sup>&nbsp;<sub>Get 17% instant discount with UOB One Card and 5% cash rebates, or&nbsp;14% instant discount with other UOB cards or Citibank Card. Find out more at&nbsp;<a href=\"https://www.shell.com.sg/rewards-and-savings/greater-credit-cards-savings-at-shell.html\">shell.com.sg/creditcards</a></sub></p>\r\n<p><sup>3</sup><sub>&nbsp;From now till 30 November 2026, get up to $8 off $80 Shell fuels voucher. Find out more in your Shell Asia App.</sub></p>\r\n<p>Present your Shell GO+ digital membership to enjoy greater savings.</p>\r\n<p>Private Hire scheme gets 22% for Cash/NETS and 24% for UOB One card, and up to $80 worth of vouchers. Find out more <a href=\"https://www.shell.com.sg/rewards-and-savings/private-hire-drivers-exclusive-discount.html\"><b>here</b></a>.</p>\r\n<h4>Note:</h4>\r\n<h4>Shell stations not retailing Shell V-Power<br>\r\n</h4>\r\n<p>Shell Woodlands Mandai</p>\r\n<h4>Shell stations not retailing Shell FuelSave Diesel&nbsp;(AGO)</h4>\r\n<p>Shell Sin Ming</p>\r\n<p>For private-hire, taxi and bus drivers, sign up for Shell GO+ professional drivers membership programme <a href=\"https://bestpetrol.com.sg/shellgoplusrewardsperks/\" target=\"_blank\" rel=\"noopener noreferrer\">here</a>.</p>\r\n"}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section/text_copy_copy"}], "model": {}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section"}, {"organism": "Container.Section", "color": "inherited", "children": [{"organism": "Container.List", "children": [{"organism": "AccordionItem", "color": "inherited", "model": {"title": "What is nett price? What is gross price?", "text": "<p>Nett price is the actual price you pay (or price after discounts are given).<br>\r\nGross price is the pump price (or price before discounts are given).</p>\r\n"}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section_1198479289/list/list_item"}, {"organism": "AccordionItem", "color": "inherited", "model": {"title": "Where can I find nett price and gross price at Shell stations?", "text": "<p>Gross prices are retail pump prices displayed at the pump.</p>\r\n<p>Nett prices are reflected at the cashier counter when you pay at the cashier.</p>\r\n<p>You will pay the nett prices or prices after discount.</p>\r\n"}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section_1198479289/list/list_item_828630081"}, {"organism": "AccordionItem", "color": "inherited", "model": {"title": "What is the actual price I am paying for my fuel purchase? What can I see on my receipt?", "text": "<p>On your receipt, you will see gross price, discounts given, quantity of fuel purchased and amount to be paid.</p>\r\n<p>You will pay the nett prices or prices after discount.</p>\r\n"}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section_1198479289/list/list_item_1285188585"}, {"organism": "AccordionItem", "color": "inherited", "model": {"title": "Are Shell petrol prices competitive compared to competitors?", "text": "<p>At Shell we strive to make every effort to provide our customers with the highest quality products at competitive prices and to reward and recognize loyalty through our Shell GO+ membership program.</p>\n<p>Find out about our Shell GO+ membership program <a href=\"https://www.shell.com.sg/rewards-and-savings/shell-app.html\" target=\"_blank\">here</a>.</p>\n"}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section_1198479289/list/list_item_593697404"}, {"organism": "AccordionItem", "color": "inherited", "model": {"title": "Where can I get more information?", "text": "<p>The latest information is available on the Shell website:&nbsp;<a href=\"https://www.shell.com.sg/\" target=\"_self\" rel=\"noopener noreferrer\">www.shell.com.sg</a></p>\r\n<p>In addition, you can contact the following:</p>\r\n<p>Shell Service Centre</p>\r\n<p>Operating Hours: 8:30am to 6.00pm (Mon-Fri)</p>\r\n<p>Address:</p>\r\n<p>Shell Marketing Centre</p>\r\n<p>31 Pandan Road</p>\r\n<p>Singapore 609278</p>\r\n<p>Tel: (65) 6235 3261 (General Public)</p>\r\n<p>Toll-Free Tel: (65) 1800-372 2733 (Escape); (65) 1800-261 5322 (Shell Card)</p>\r\n<p>Fax: (65) 6263 2855</p>\r\n"}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section_1198479289/list/list_item_70403542"}], "colstart": 3, "colspan": 8, "model": {}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section_1198479289/list"}], "model": {"title": "Frequently asked questions"}, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section_1198479289"}, {"organism": "Container.Section", "color": "brand1-subtle", "children": [{"organism": "PromoCard", "color": "brand1", "model": {"title": "Shell V-Power", "text": "<p>Discover the New and Improved Shell V-Power, our best ever performance fuel which 100% cleans critical engine parts.</p>\r\n", "links": [{"name": "Shell V-Power", "value": "https://www.shell.com.sg/fuels-oils-and-coolants/shell-fuels/shell-v-power.html"}], "image": {"src": "https://www.shell.com.sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/_jcr_content/root/main/section_1400226383/promo.shellimg.png/1738585480016/shell-v-power-banner.png", "alt": "Shell V Power", "width": 3828, "height": 2154}}, "colspan": 4, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section_1400226383/promo"}, {"organism": "PromoCard", "color": "brand1", "model": {"title": "Shell FuelSave", "text": "<p>Discover the New and Improved Shell FuelSave that provides an enhanced fuel economy that helps you go up to 15km further per tank.</p>\r\n", "links": [{"name": "Shell FuelSave", "value": "https://www.shell.com.sg/fuels-oils-and-coolants/shell-fuels/shell-fuelsave-fuels.html"}], "image": {"src": "https://www.shell.com.sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/_jcr_content/root/main/section_1400226383/promo_copy.shellimg.jpeg/1738585681515/hand-holding-steering-wheel.jpeg", "alt": "steering wheel", "width": 2020, "height": 1137}}, "colspan": 4, "id": "/content/shell/countries/singapore/en_sg/fuels-oils-and-coolants/shell-fuels/shell-station-price-board/jcr_content/root/main/section_1400226383/promo_copy"}, {"organism": "PromoSimple.LinkList", "color": "brand1", "colspan": 4, "model": {"links": [{"name": "Station Locator", "value": "https://www.shell.com.sg/shell-service-station/shell-station-locator.html"}, {"name": "Promotions", "value": "https://www.shell.com.sg/shell-ser